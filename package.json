{
  "name": "@pitant-industries/file-icons",
  "version": "0.1.0",
  "description": "File format icons for industrial engineering, business and media workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PITANT-Industries/pitant-file-icons.git"
  },
  "homepage": "https://github.com/PITANT-Industries/pitant-file-icons#readme",
  "bugs": {
    "url": "https://github.com/PITANT-Industries/pitant-file-icons/issues"
  },
  "keywords": [
    "svg",
    "icons",
    "file-types",
    "file-formats",
    "industrial",
    "cad",
    "react"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./formats.json": "./formats.json",
    "./icons/*.svg": "./icons/*.svg",
    "./sprite.svg": "./dist/sprite.svg",
    "./sprite-monochrome.svg": "./dist/sprite-monochrome.svg"
  },
  "files": [
    "dist",
    "formats.json",
    "icons/*.svg",
    "docs/preview.svg",
    "docs/releasing.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run build && node --test test/*.test.mjs && tsc --noEmit --strict --module NodeNext --jsx react-jsx --lib es2022,dom test/types/usage.tsx",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
